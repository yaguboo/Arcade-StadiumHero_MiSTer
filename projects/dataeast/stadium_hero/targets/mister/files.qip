# --------------------------------------------------------------------------
# Data East "Stadium Hero" -- source list
#
# Add files here, NEVER through the Quartus IDE -- it rewrites the .qsf.
# --------------------------------------------------------------------------

# ---- MiSTer board wrapper -------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE StadiumHero.sv
set_global_assignment -name SYSTEMVERILOG_FILE sh_dbg.sv
set_global_assignment -name SDC_FILE StadiumHero.sdc

# ---- PLL (retargeted to 60.000 MHz; see rtl/pll/pll_0002.v) ---------------
set_global_assignment -name QIP_FILE rtl/pll.qip

# ---- include search paths -------------------------------------------------
# sh_rommap.svh is `include'd by sh_romarb.sv, and the jt65c02 microcode
# headers (65c02_param.vh, 65c02.vh) by the CPU's own sources.
set_global_assignment -name SEARCH_PATH ../../rtl
set_global_assignment -name SEARCH_PATH ../../../../../third_party/cpu/jt65c02
# fx68k and jt6295 load ROM images with a BARE filename ($readmemb("microrom.mem"),
# $readmemh("jt6295_up4.hex")).  Quartus resolves those against the search path,
# so every directory holding one has to be listed or the module elaborates with
# an empty ROM -- which is not an error, just a CPU that executes nothing.
set_global_assignment -name SEARCH_PATH ../../../../../third_party/cpu/fx68k
set_global_assignment -name SEARCH_PATH ../../../../../third_party/audio/jt6295
# `include "sys/emu_ports.vh"` in the target wrapper is the standard MiSTer
# idiom and is left exactly as upstream writes it.  With the framework now
# shared from platforms/mister/, the directory that makes `sys/...` resolve is
# platforms/mister itself, so it goes on the search path rather than editing
# the include.  2026-09-08, docs/AUDIT_2026_CROSS_PROJECT.md Tier A.
#
# Found by RUNNING Quartus, not by grep: the wrapper .sv files were not in the
# set of build files the path rewrite covered, and the failure is
# "can't open Verilog Design File sys/emu_ports.vh" -- loud, but only at
# elaboration.
set_global_assignment -name SEARCH_PATH ../../../../../platforms/mister

# ---- platform transport (integration/, not rtl/) --------------------------
# Root CLAUDE.md section 4: ioctl_* stops here and does not enter the board.
set_global_assignment -name SYSTEMVERILOG_FILE ../../integration/sh_download.sv

# ---- 68000 (fx68k, GPLv3, (c) Jorge Cwik) ---------------------------------
# Copied from Power Spikes; carries NA-1/NA-2's additive dbg_d7 port.
# docs/LICENSE_USAGE_REPORT.md.
set_global_assignment -name SYSTEMVERILOG_FILE ../../../../../third_party/cpu/fx68k/fx68kAlu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../../../third_party/cpu/fx68k/uaddrPla.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../../../third_party/cpu/fx68k/fx68k.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/sh_m68k.sv

# ---- 65C02 (jt65c02, GPL-3.0-or-later, (c) Jose Tejada) -------------------
# The microcode ROM and its two headers are GENERATED -- docs/DECISIONS.md D4.
# 65c02.uc is read by $readmemb at elaboration, so it is a MISC_FILE here and
# must also sit beside the bitstream's working directory for simulation.
set_global_assignment -name VERILOG_FILE ../../../../../third_party/cpu/jt65c02/jt65c02_alu.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/cpu/jt65c02/jt65c02_ctrl.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/cpu/jt65c02/jt65c02_regs.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/cpu/jt65c02/jt65c02.v
set_global_assignment -name MISC_FILE ../../../../../third_party/cpu/jt65c02/65c02.uc

