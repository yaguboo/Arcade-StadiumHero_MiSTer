<misterromdescription>
    <name>Stadium Hero</name>
    <setname>stadhero</setname>
    <year>1988</year>
    <manufacturer>Data East</manufacturer>
    <rbf>StadiumHero</rbf>

    <!-- Generated by tools/build_rom.py.  The offsets here and in
         rtl/sh_rommap.svh come from the same table; do not edit either alone.

         THE RELEASE .mra (2026-10-06).  It reads MAME's own stadhero.zip, so a
         user needs nothing but the MAME set.  Until then it was an experiment
         marked "do not ship": the sprites came out in the wrong colours.  The
         digit order was not the cause.  Two generator bugs were: the sprite
         plane table was reversed against build() (ef06/ef07 as plane 0), and
         the tile region was padded as 0x80000 bytes when it is 0x40000, which
         put the sprites at 0xA0000 instead of 0xE0000.  Fixed, this file
         rebuilds the flat image byte for byte (a loader model, rightmost map
         digit = output byte 0 as Heavy Smash / Power Spikes showed on
         hardware), and on the board three attract shots match the flat
         loader's but for the blinking INSERT COIN (644 of 61,440 px). -->

    <rom index="0" zip="stadhero.zip" md5="none">
        <!-- maincpu @ 000000.  ef15 is the EVEN byte. -->
        <interleave output="16">
          <part name="ef15.9a" crc="bbba364e" map="01"/>
          <part name="ef13.4e" crc="97c6717a" map="10"/>
        </interleave>
        <!-- audiocpu @ 020000, the image of 0x8000 to 0xffff -->
        <part name="ef18.7f" crc="20fd9668"/>
        <!-- oki @ 028000 -->
        <part name="ef17.1e" crc="07c78358"/>
        <part repeat="0x8000">00</part>
        <!-- chars @ 040000, 3bpp packed into 32-bit words -->
        <interleave output="32">
          <part name="ef09.4j" crc="2ade874d" offset="0x0" length="0x8000" map="0001"/>
          <part name="ef08.2j" crc="e84752fe" offset="0x8000" length="0x8000" map="0010"/>
          <part name="ef08.2j" crc="e84752fe" offset="0x0" length="0x8000" map="0100"/>
          <!-- plane 3 is unused at 3bpp and reads as zero -->
        </interleave>
        <!-- tiles @ 060000 -->
        <interleave output="32">
          <part name="ef11.13j" crc="af563e96" offset="0x0" length="0x10000" map="0001"/>
          <part name="ef10.11j" crc="dca3d599" offset="0x0" length="0x10000" map="0010"/>
          <part name="ef12.14j" crc="9a1bf51c" offset="0x0" length="0x10000" map="0100"/>
          <!-- plane 3 is unused at 3bpp and reads as zero -->
        </interleave>
        <part repeat="0x40000">00</part>
        <!-- sprites @ 0E0000 -->
        <interleave output="32">
          <part name="ef00.2a" crc="94ed257c" offset="0x0" length="0x10000" map="0001"/>
          <part name="ef02.5a" crc="850cb771" offset="0x0" length="0x10000" map="0010"/>
          <part name="ef04.8a" crc="9e3d97a7" offset="0x0" length="0x10000" map="0100"/>
          <part name="ef06.11a" crc="9f47848f" offset="0x0" length="0x10000" map="1000"/>
        </interleave>
        <interleave output="32">
          <part name="ef01.4a" crc="6eb9a721" offset="0x0" length="0x10000" map="0001"/>
          <part name="ef03.7a" crc="24338b96" offset="0x0" length="0x10000" map="0010"/>
          <part name="ef05.9a" crc="88631005" offset="0x0" length="0x10000" map="0100"/>
          <part name="ef07.12a" crc="8859f655" offset="0x0" length="0x10000" map="1000"/>
        </interleave>
    </rom>

    <!-- OSD defaults: status[23:0], high byte first.  Bit 0 (Reset) is masked
         off by the core, so a stray 1 here cannot wedge the boot. -->
    <rom index="1"><part>00 00 00</part></rom>

    <!-- DIP switches.  Every PORT_DIPNAME in stadhero.cpp:276-311, in the
         driver's own order, with the settings listed by the RAW BIT VALUE the
         first `bits` entry makes the LSB of  -  which is NOT the order the
         driver lists them in.  Coin A is the clearest case: the driver writes
         3C_1C, 2C_1C, 1C_1C, 1C_2C but their masks are 0, 1, 3, 2.

         default="FF,FF" is every switch in its documented default position,
         Demo Sounds ON and Flip Screen OFF included.  The HPS sends eight
         bytes at ioctl index 254 whatever the MRA declares; the core takes the
         first two and ignores the rest (StadiumHero.sv).

         PORT_DIPUNUSED covers bits 4, 7, 14 and 15.  They are listed anyway  - 
         an operator looking at a real SW1/SW2 sees eight positions per block,
         and a switch missing from the page reads as "this core forgot one"
         rather than "the game ignores it". -->
    <switches default="FF,FF" base="0">
        <dip name="Coin A"           bits="0,1"   ids="3C/1C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Coin B"           bits="2,3"   ids="3C/1C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Unused SW1-5"     bits="4"     ids="On,Off"/>
        <dip name="Demo Sounds"      bits="5"     ids="Off,On"/>
        <dip name="Flip Screen"      bits="6"     ids="On,Off"/>
        <dip name="Unused SW1-8"     bits="7"     ids="On,Off"/>
        <dip name="Time (1P Vs CPU)" bits="8,9"   ids="400,450,600,500"/>
        <dip name="Time (1P Vs 2P)"  bits="10,11" ids="120,180,270,210"/>
        <dip name="Final Set"        bits="12,13" ids="6 Credits,5 Credits,3 Credits,4 Credits"/>
        <dip name="Unused SW2-7"     bits="14"    ids="On,Off"/>
        <dip name="Unused SW2-8"     bits="15"    ids="On,Off"/>
    </switches>

    <!-- Service is a momentary switch on the cabinet, not a DIP: COIN bit 6
         (stadhero.cpp:317).  It gets a pad button so the operator menu is
         reachable without an OSD round trip. -->
    <buttons names="Pickoff,Swing/Pitch/Run,Time/Sub,Start,Coin,Pause"
             default="A,B,X,Start,Select,R" count="6"/>
</misterromdescription>
